# ─────────────────────────────────────────────────────────────────────────────
# Text to Image Generator – environment configuration
# Copy to .env and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──
DATABASE_URL="postgresql://pixelforge:pixelforge@localhost:5432/pixelforge?schema=public"
APP_URL="http://localhost:3000"                  # public base URL, no trailing slash (https:// in production)
AUTH_SECRET=""                                   # 32+ random chars: openssl rand -base64 48
SUPPORT_EMAIL="support@example.com"
ADMIN_EMAILS=""                                  # comma-separated; these accounts become admin after verifying their email

# ── Google OAuth (optional) ──
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Image generation providers (configure at least one) ──
# Stability AI – Stable Image Core / Ultra / SD 3.5, img2img, upscale, background removal
STABILITY_API_KEY=""
# Replicate – FLUX.1 [schnell]
REPLICATE_API_TOKEN=""
# OpenAI – gpt-image-1 generation and edits (also used for optional moderation)
OPENAI_API_KEY=""
# Clipdrop – text-to-image, reimagine, upscale, remove/replace background
CLIPDROP_API_KEY=""
IMAGE_PROVIDER_TIMEOUT_MS=120000
# Advanced: override provider base URLs (proxies, gateways). Leave unset normally.
# STABILITY_API_BASE="https://api.stability.ai"
# REPLICATE_API_BASE="https://api.replicate.com/v1"
# OPENAI_API_BASE="https://api.openai.com/v1"
# CLIPDROP_API_BASE="https://clipdrop-api.co"

# ── Prompt enhancer (LLM) ──
# LLM_PROVIDER=openai works with any OpenAI-compatible Chat Completions API (OpenAI, Groq, OpenRouter, Together…)
LLM_PROVIDER="openai"                            # openai | anthropic
LLM_API_KEY=""
LLM_MODEL=""                                     # e.g. gpt-4o-mini, or claude-haiku-4-5 for anthropic
LLM_API_BASE=""                                  # e.g. https://api.groq.com/openai/v1 (optional)
LLM_TIMEOUT_MS=30000

# ── Moderation ──
OPENAI_MODERATION="false"                        # "true" adds OpenAI moderation on top of the built-in blocklist

# ── Razorpay (INR payments) ──
RAZORPAY_KEY_ID=""                               # rzp_test_… for test mode, rzp_live_… for live
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""                       # Dashboard → Webhooks → URL ${APP_URL}/api/webhooks/razorpay
# Optional: Razorpay plan IDs picked up by `npm run db:seed` (can also be set in Admin → Configuration)
RAZORPAY_PLAN_CREATOR_MONTHLY=""
RAZORPAY_PLAN_PRO_MONTHLY=""
RAZORPAY_PLAN_STUDIO_MONTHLY=""

# ── Image storage ──
STORAGE_DRIVER="local"                           # local (dev, single server) | s3 (AWS S3, R2, MinIO…) | vercel-blob
# BLOB_READ_WRITE_TOKEN=""                       # set automatically by Vercel → Storage → Blob (used automatically on Vercel)
LOCAL_STORAGE_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""                                   # e.g. https://<account>.r2.cloudflarestorage.com (empty for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"                      # true for MinIO

# ── Email ──
EMAIL_PROVIDER="console"                         # console (dev: logged, not delivered) | resend | smtp
EMAIL_FROM="Text to Image Generator <no-reply@yourdomain.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# ── Infrastructure ──
REDIS_URL=""                                     # e.g. redis://localhost:6379 – shared rate limits across instances
JOB_RUNNER="inline"                              # inline (single server) | worker (run `npm run worker` separately)
WORKER_CONCURRENCY=2
